{
  "version": "piece-lab/0.1.0",
  "purpose": "Executable movement and inventory rules for testing catalog pieces on a fictional tabletop.",
  "scale": "One platform per platform piece; one equipment item per part. Movement points and cargo slots are authored game quantities, not kilometers, minutes, seats or kilograms.",
